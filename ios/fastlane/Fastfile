default_platform(:ios)

platform :ios do
  desc "Build a signed release and upload to TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )

    # Signing certs + provisioning profiles live on the `certs` branch of this repo.
    match(
      type: "appstore",
      app_identifier: "co.sustany.ironq",
      git_url: "https://github.com/sustany/irongame.git",
      git_branch: "certs",
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV.fetch('MATCH_GIT_TOKEN')}"),
      api_key: api_key,
      readonly: false
    )

    build_app(
      project: "IronQ.xcodeproj",
      scheme: "IronQ",
      export_method: "app-store",
      output_directory: "build",
      xcargs: [
        "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
        "CURRENT_PROJECT_VERSION=#{ENV['BUILD_NUMBER'] || '1'}",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "PROVISIONING_PROFILE_SPECIFIER='match AppStore co.sustany.ironq'"
      ].join(" ")
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
